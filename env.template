# Database
POSTGRES_DB=zigbee_monitoring
POSTGRES_USER=zigbee_user
POSTGRES_PASSWORD=zigbee_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,admin-panel
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SENSOR_RAW_TOPIC=sensor-raw

# MQTT
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ZIGBEE2MQTT_TOPIC=zigbee2mqtt/#

# Zigbee Core Services
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# TimescaleDB
TIMESCALEDB_EXTENSION_ENABLED=True

# Sensor Simulator (для dev)
SIMULATOR_NUM_DEVICES=5
SIMULATOR_UPDATE_INTERVAL=30  # секунды
SIMULATOR_MQTT_TOPIC_PREFIX=zigbee2mqtt
