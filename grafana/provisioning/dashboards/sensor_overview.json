{
    "title": "Zigbee Датчики - Мониторинг",
    "uid": "zigbee-sensors",
    "version": 1,
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "timezone": "browser",
    "refresh": "10s",
    "tags": [
        "zigbee",
        "iot",
        "sensors"
    ],
    "editable": true,
    "gnetId": null,
    "graphTooltip": 1,
    "links": [],
    "panels": [
        {
            "id": 1,
            "title": "Температура",
            "type": "timeseries",
            "datasource": "PostgreSQL",
            "targets": [
                {
                    "rawSql": "SELECT\n    sm.generated_time AS \"time\",\n    ieee_address AS \"metric\",\n    (sm.data->'temperature')::float AS temperature\nFROM public.sensor_measurements AS sm\nWHERE $__timeFilter(sm.generated_time)\nORDER BY sm.generated_time ASC",
                    "format": "time_series",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "celsius",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "barAlignment": 0,
                        "lineWidth": 1,
                        "fillOpacity": 10,
                        "gradientMode": "none",
                        "spanNulls": false,
                        "showPoints": "auto",
                        "pointSize": 5,
                        "stacking": {
                            "mode": "none",
                            "group": "A"
                        },
                        "axisPlacement": "auto"
                    }
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            }
        },
